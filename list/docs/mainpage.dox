/**
 * @mainpage Skip List C++ Library
 *
 * @section intro_sec Introduction
 * This documentation describes the SkipList template library, a memory-safe, STL-style skip list.
 *
 * @section usage_sec Basic Example
 * @code
 * SkipList<int> sl;
 * sl.insert(1);
 * sl.insert(2);
 * if (sl.find(1)) {
 *     std::cout << "Found!" << std::endl;
 * }
 * @endcode
 */